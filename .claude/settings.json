{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": { "ecc@ecc": true },
  "env": {
    "ECC_HOOK_PROFILE": "standard",
    "AWS_PROFILE": "default"
  },
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm install*)",
      "Bash(node *)",
      "Read(src/**)",
      "Edit(src/**)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(./**/*.pem)",
      "Read(.memory/**)",
      "Bash(aws *)",
      "Bash(cat .env*)"
    ]
  }
}
